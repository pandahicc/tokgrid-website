---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  className?: string;
  headingId?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  className = '',
  headingId,
} = Astro.props;
---

<div
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
        {eyebrow}
      </p>
    )
  }
  <h2
    id={headingId}
    class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl"
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
        {description}
      </p>
    )
  }
</div>
