---
import { NAV } from '../data/site';
import Icon from './Icon.astro';
import InstallButton from './InstallButton.astro';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="TokGrid home">
        <img
          src="/images/tokgrid-icon-48.png"
          width="32"
          height="32"
          alt=""
          class="h-8 w-8 rounded-lg"
        />
        <span class="text-lg font-bold tracking-tight text-slate-950">TokGrid</span>
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'text-brand-700'
                  : 'text-slate-600 hover:text-slate-950',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden shrink-0 sm:block">
        <InstallButton campaign="header" size="sm" />
      </div>

      <div class="shrink-0 sm:hidden">
        <InstallButton
          campaign="header-mobile-compact"
          size="sm"
          label="Install"
        />
      </div>

      <details class="group relative md:hidden">
        <summary
          class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-50"
          aria-label="Open navigation menu"
        >
          <Icon name="menu" class="h-5 w-5" />
        </summary>
        <div
          class="absolute right-0 top-12 w-72 rounded-2xl border border-slate-200 bg-white p-4 shadow-xl"
        >
          <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-2.5 text-sm font-medium',
                    isActive(item.href)
                      ? 'bg-brand-50 text-brand-700'
                      : 'text-slate-700 hover:bg-slate-50',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href="/support/"
              class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              Support
            </a>
            <a
              href="/about/"
              class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              About
            </a>
          </nav>
          <div class="mt-4 border-t border-slate-100 pt-4">
            <InstallButton
              campaign="header-mobile"
              size="sm"
              className="w-full justify-center"
            />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
