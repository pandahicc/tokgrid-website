---
import Icon from './Icon.astro';

interface Props {
  feature: {
    title: string;
    href: string;
    icon: string;
    description: string;
  };
}

const { feature } = Astro.props;
---

<a
  href={feature.href}
  class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
>
  <span
    class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
  >
    <Icon name={feature.icon} class="h-5 w-5" />
  </span>
  <h3 class="text-lg font-bold text-slate-950">{feature.title}</h3>
  <p class="mt-2 text-sm leading-6 text-slate-600">{feature.description}</p>
  <span
    class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
  >
    Explore feature
    <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
  </span>
</a>
