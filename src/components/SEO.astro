---
import { canonicalUrl, SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  image = '/og/tokgrid-og.png',
  canonicalPath,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const canonical = noindex ? null : canonicalUrl(canonicalPath ?? Astro.url.pathname);
const ogImage = new URL(image, SITE.url).href;
const serializedJsonLd = jsonLd.map((schema) =>
  JSON.stringify(schema).replace(/</g, '\\u003c'),
);
---

<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
/>
<meta name="theme-color" content="#4f46e5" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  serializedJsonLd.map((schema) => (
    <script type="application/ld+json" is:inline set:html={schema} />
  ))
}
