---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import ScreenshotSlot from '../components/ScreenshotSlot.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoreProof from '../components/StoreProof.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_EXTENSION_FAQS } from '../data/faqs';
import { SITE } from '../data/site';
import {
  breadcrumbSchema,
  faqSchema,
  softwareApplicationSchema,
} from '../lib/schema';

const title = 'TikTok Video Downloader Chrome Extension — Install TokGrid';
const description =
  'Install the TokGrid Chrome extension for TikTok page analytics, product research, video and subtitle downloads, and Pro batch downloads. Desktop Chrome 111+.';

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Chrome Extension', href: '/chrome-extension/' },
  ]),
  faqSchema(CHROME_EXTENSION_FAQS),
  softwareApplicationSchema(),
];

const installSteps = [
  [
    'Add TokGrid to Chrome',
    'Open the Chrome Web Store listing, choose Add to Chrome, and confirm the permission prompt. The request covers extension storage and read access to TikTok page data.',
  ],
  [
    'Pin the icon',
    'Open the puzzle-piece Extensions menu in the Chrome toolbar and pin TokGrid. The panel is then one click away on every supported page.',
  ],
  [
    'Open a public TikTok page',
    'Go to a public video, profile, search, hashtag, Explore, or music list page. The panel appears on the right. On Home, Explore, and video detail pages it starts collapsed; use the right-edge tab to open it.',
  ],
] as const;

const permissions = [
  [
    'storage',
    'Settings, the local page snapshot, and the encrypted subscription credential.',
  ],
  [
    '*.tiktok.com',
    'Read the cards already rendered on a public page, and request a media or subtitle URL only when you click a download control.',
  ],
  [
    '*.tiktokcdn.com, *.tiktokv.com',
    'Fetch the media and subtitle files that the page exposes when you ask for them.',
  ],
  [
    'pandahi.cc',
    'Subscription activation, token restore, and status refresh. It does not carry page data.',
  ],
] as const;

const notRequested = ['downloads', 'webRequest', 'scripting', 'tabs', '<all_urls>'];

const comparison = [
  ['Open a pasted video link', 'TikTok oEmbed player preview', 'Works on the TikTok page you open'],
  ['Download a video file', 'No', 'Yes, free, no watermark'],
  ['Download subtitle tracks (VTT/SRT)', 'No', 'Yes, free, when exposed'],
  ['Analyze the loaded page sample', 'No', 'Yes'],
  ['Batch download a profile', 'No', 'Pro'],
  ['CSV/JSON export', 'No', 'Pro'],
  ['Runs on', 'Any modern browser', 'Desktop Chrome 111+'],
] as const;

const freePro = [
  ['Free', 'Page overlay, data list, filters, sample analytics, product browsing, single video download, single subtitle download.'],
  ['Pro', 'Batch downloads to a folder, selected-video CSV/JSON export, and product data export.'],
] as const;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/chrome-extension/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Chrome Extension', href: '/chrome-extension/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Chrome extension
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            TikTok Video Downloader Chrome Extension
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            TokGrid adds a panel to public TikTok pages: review views, engagement, and
            product data, then download a video or its subtitles without leaving the page.
            Processing stays in your browser, and no account is required for core use.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton
              campaign="chrome-extension-hero"
              size="lg"
              label="Add to Chrome — Free"
              showNote
            />
            <a
              href="/features/bulk-download/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              See the download feature
            </a>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-slate-500">
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="h-3.5 w-3.5 text-brand-600" />
              Desktop Chrome 111+
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="h-3.5 w-3.5 text-brand-600" />
              No account for core use
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="h-3.5 w-3.5 text-brand-600" />
              Local processing
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="h-3.5 w-3.5 text-brand-600" />
              No telemetry
            </li>
          </ul>
          <StoreProof />
        </div>
        <ScreenshotSlot
          id="overlay"
          priority
          caption="A public TikTok page with the TokGrid panel open. The overlay badges and the panel are the same extension."
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Install"
        title="Three steps, then the panel is on the page."
        description="TokGrid is distributed through the Chrome Web Store. There is no separate installer and no account step for the free features."
      />
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {
          installSteps.map(([heading, text], index) => (
            <li class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <h3 class="mt-4 text-base font-bold text-slate-950">{heading}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 max-w-3xl text-sm leading-6 text-slate-500">
        Chrome may show a permission prompt with the extension name. The exact
        permissions and their purpose are listed below. TokGrid is an independent
        third-party extension and is not affiliated with TikTok.
      </p>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading
          eyebrow="After install"
          title="What you actually see on the page."
          description="The panel is attached to the public page you opened. It does not replace TikTok and it does not open a separate dashboard."
        />
        <a
          href="/features/video-analytics/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
        >
          Explore the analytics
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <ScreenshotSlot id="data-list" caption="The Data tab: covers, metrics, quick filters, sorting, and selection." />
        <ScreenshotSlot id="batch" caption="The Pro batch queue: folder, overall and per-item progress, failures, and cancel." />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeading
          eyebrow="Permissions"
          title="Why it needs to read tiktok.com."
          description="The extension reads public page data that your browser has already loaded. It does not run a background crawler and it does not upload page data."
        />
        <div class="space-y-5">
          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full border-collapse text-left text-sm">
              <caption class="sr-only">Requested permissions and their purpose</caption>
              <thead class="bg-slate-50">
                <tr>
                  <th scope="col" class="px-4 py-3 font-bold text-slate-900">Requested</th>
                  <th scope="col" class="px-4 py-3 font-bold text-slate-900">Why</th>
                </tr>
              </thead>
              <tbody>
                {permissions.map(([name, purpose]) => (
                  <tr class="border-t border-slate-100">
                    <th scope="row" class="px-4 py-3 font-mono text-xs font-semibold text-slate-800">{name}</th>
                    <td class="px-4 py-3 text-slate-600">{purpose}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-sm font-bold text-slate-950">Not requested</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {notRequested.map((item) => (
                <code class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs text-slate-600">
                  {item}
                </code>
              ))}
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600">
              Media and subtitle requests happen only after you click a download control.
              Subscription validation is a separate license check at <code>pandahi.cc</code>{' '}
              and does not include page data.{' '}
              <a href="/privacy/" class="font-semibold text-brand-700 hover:underline">
                Read the Privacy Policy
              </a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Website vs extension"
        title="The website previews. The extension downloads."
        description="This distinction matters: a pasted link on the website can show a TikTok player, but the file download only exists inside the extension."
      />
      <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">Website and extension capabilities</caption>
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-5 sm:py-3.5 font-bold text-slate-900">Capability</th>
              <th scope="col" class="px-3 py-3 sm:px-5 sm:py-3.5 font-bold text-slate-900">This website</th>
              <th scope="col" class="px-3 py-3 sm:px-5 sm:py-3.5 font-bold text-slate-900">TokGrid extension</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([label, site, extension]) => (
              <tr class="border-t border-slate-100">
                <th scope="row" class="px-3 py-3 sm:px-5 sm:py-3.5 font-medium text-slate-700">{label}</th>
                <td class="px-3 py-3 sm:px-5 sm:py-3.5 text-slate-600">{site}</td>
                <td class="px-3 py-3 sm:px-5 sm:py-3.5 text-slate-600">{extension}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div>
          <SectionHeading
            eyebrow="Free and Pro"
            title="Start with the free core."
            description="Pro is a paid upgrade. Current plan details are available in the extension; this page does not display subscription pricing."
          />
          <div class="mt-6 space-y-4">
            {freePro.map(([plan, text]) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <h3 class="text-sm font-bold text-slate-950">{plan}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
          <div class="flex gap-4">
            <Icon name="info" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
            <div>
              <h2 class="text-lg font-bold text-slate-950">Desktop Chrome only.</h2>
              <p class="mt-2 text-sm leading-7 text-slate-700">
                TokGrid requires desktop Chrome 111 or newer. Chrome for Android and
                Chrome for iOS do not support extensions, so the panel cannot run on a
                phone or tablet. Chromium-based desktop browsers may work, but they are
                not officially supported.
              </p>
              <p class="mt-3 text-sm leading-7 text-slate-700">
                Batch download also needs the File System Access API and a folder you
                choose through the browser prompt. That is a desktop browser feature.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="FAQ"
        title="Installation questions."
        align="center"
      />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={CHROME_EXTENSION_FAQS} />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-brand-200 bg-brand-50/60 p-6 sm:p-10">
        <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
              Next step
            </p>
            <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">
              Install once, then work on the page you already have open.
            </h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              The extension reads the cards the public page has rendered, and writes
              downloads locally. Only download content you have the rights to use.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href="/guides/how-to-bulk-download-tiktok-videos/"
              class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400"
            >
              Read the bulk download guide
            </a>
            <a
              href="/support/"
              class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400"
            >
              Get support
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA
    campaign="chrome-extension-final"
    title="Add TokGrid to Chrome and open a public TikTok page."
    description={`Version ${SITE.version}. Free core features; Pro adds batch downloads and export. Desktop Chrome 111 or newer.`}
    secondaryHref="/features/bulk-download/"
    secondaryLabel="See the TikTok video downloader"
  />
</BaseLayout>
