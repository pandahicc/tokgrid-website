---
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedGuides } from '../../lib/content';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema';

const title = 'TikTok Research Guides — TokGrid Blog';
const description =
  'Practical guides for analyzing public TikTok video performance, engagement, competitors, products, downloads, and CSV/JSON exports.';

const guides = await getPublishedGuides();
const featured = guides.find((guide) => guide.data.featured) ?? guides[0] ?? null;
const rest = guides.filter((guide) => guide.id !== featured?.id);
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/guides/' },
  ]),
  itemListSchema(
    guides.map((guide) => ({
      name: guide.data.title,
      href: `/guides/${guide.id}/`,
    })),
  ),
];
---

<BaseLayout title={title} description={description} canonicalPath="/guides/" jsonLd={jsonLd}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Guides', href: '/guides/' },
        ]}
      />
      <div class="mt-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          TokGrid blog
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          TikTok Research Guides
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Practical, source-limited guides for working with the public TikTok data you
          can see in your browser. Each guide explains the workflow, the calculation,
          and the boundary — including what the sample cannot tell you.
        </p>
        <p class="mt-4 text-sm text-slate-500">
          {guides.length} published {guides.length === 1 ? 'guide' : 'guides'} · Written by the TokGrid team
        </p>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="bg-white py-12 sm:py-16">
        <div class="container-page">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">
                Start here
              </p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
                The featured guide
              </h2>
            </div>
            <span class="text-sm text-slate-500">Updated for the current TokGrid build</span>
          </div>
          <div class="mt-6">
            <ArticleCard entry={featured} featured />
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading
          eyebrow="All guides"
          title="Browse the library"
          description="Choose the question closest to the work in front of you. All guides are written for the current public-page workflow."
        />
        <a
          href="/features/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
        >
          Explore features
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      {
        rest.length > 0 ? (
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((guide) => <ArticleCard entry={guide} />)}
          </div>
        ) : (
          <p class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-600">
            More guides are being prepared. Start with the featured guide above.
          </p>
        )
      }
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-8 rounded-3xl border border-brand-200 bg-brand-50/60 p-6 sm:p-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">
            A note on method
          </p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">
            A page sample is useful when you describe it honestly.
          </h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            The guides use the same boundaries as the extension: public pages only,
            already-rendered cards only, page-snapshot metrics, and no promise of
            complete histories or platform-wide statistics. Every guide links back to the
            relevant feature page and its limits.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="/features/video-analytics/" class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400">
            Video analytics
          </a>
          <a href="/features/product-research/" class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400">
            Product research
          </a>
          <a href="/features/data-export/" class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400">
            Data export
          </a>
          <a href="/privacy/" class="rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:border-brand-400">
            Privacy
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTA
    campaign="guides-index"
    title="Read the method, then test it on a public page."
    description="Install TokGrid and open a supported public TikTok page. Core features are free; Pro adds batch downloads and CSV/JSON export."
    secondaryHref="/features/"
    secondaryLabel="Explore the features"
  />
</BaseLayout>
