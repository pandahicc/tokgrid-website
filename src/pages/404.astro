---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found — TokGrid';
const description =
  'The page you requested could not be found. Return to the TokGrid homepage, features, or TikTok research guides.';
---

<BaseLayout
  title={title}
  description={description}
  noindex
  canonicalPath="/404/"
>
  <section class="bg-slate-50 py-20 sm:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          404
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Page not found
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          The page you requested does not exist, or it may have moved. The useful parts of
          the site are still here.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
            <Icon name="home" class="h-4 w-4" />
            Home
          </a>
          <a href="/features/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:border-brand-300 hover:bg-brand-50">
            Features
          </a>
          <a href="/guides/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:border-brand-300 hover:bg-brand-50">
            Guides
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
