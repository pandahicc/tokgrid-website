---
import CTA from '../../components/CTA.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FEATURES, SITE } from '../../data/site';

const title = 'TokGrid Features — TikTok Page Analytics & Downloads';
const description =
  'Explore TokGrid features for TikTok video analytics, product research, video and subtitle downloads, and CSV/JSON data export on public pages.';

const principles = [
  {
    icon: 'shield',
    title: 'Public pages only',
    text: 'TokGrid works with content already rendered in a public TikTok page. It does not bypass login, CAPTCHA, or rate limits.',
  },
  {
    icon: 'chart',
    title: 'Sample-first analytics',
    text: 'Statistics describe the current loaded and filtered sample. Medians, coverage, and rankings are not platform-wide estimates.',
  },
  {
    icon: 'lock',
    title: 'Local page processing',
    text: 'Page data is processed in the browser. Subscription validation is a separate license check that does not include page data.',
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/features/">
  <section class="relative overflow-hidden border-b border-slate-200 bg-slate-50">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid opacity-50">
    </div>
    <div class="container-page relative py-16 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
        Features
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
        Everything TokGrid does on a public TikTok page.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        Four connected workflows: review video performance, organize product anchors,
        download media you have the rights to use, and take selected data into a
        spreadsheet or script.
      </p>
      <div class="mt-8">
        <a
          href="/guides/"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
        >
          See the practical guides
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 sm:grid-cols-2">
        {FEATURES.map((feature) => <FeatureCard feature={feature} />)}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Shared principles"
        title="The boundaries are part of the product."
        description="TokGrid is deliberately scoped. Understanding those boundaries is the difference between a useful sample and a misleading conclusion."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          principles.map((principle) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                <Icon name={principle.icon} class="h-5 w-5" />
              </span>
              <h2 class="mt-4 text-base font-bold text-slate-950">{principle.title}</h2>
              <p class="mt-2 text-sm leading-6 text-slate-600">{principle.text}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 max-w-3xl text-sm leading-6 text-slate-500">
        TokGrid is an independent browser extension and is not affiliated with,
        endorsed by, or sponsored by TikTok or ByteDance. See the{' '}
        <a href="/privacy/" class="font-semibold text-brand-700 hover:underline">Privacy Policy</a>{' '}
        for the data-handling details.
      </p>
    </div>
  </section>

  <CTA
    campaign="features-index"
    title="Open a public page and see the sample for yourself."
    description="Core features are free. Pro adds batch downloads and CSV/JSON export for selected videos and product data."
    secondaryHref="/guides/"
    secondaryLabel="Read the guides"
  />
</BaseLayout>
