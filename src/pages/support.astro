---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPPORT_FAQS } from '../data/faqs';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { SITE } from '../data/site';

const title = 'Support & FAQ — TokGrid';
const description =
  'Installation, supported pages, Pro activation, download troubleshooting, and answers to common TokGrid questions.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Support', href: '/support/' },
  ]),
  faqSchema(SUPPORT_FAQS),
];

const supportedPages = [
  'Home, For You, and Following',
  'Video detail pages',
  'Hashtag pages',
  'Search results',
  'User profiles',
  'Explore',
  'Music detail video lists',
];

const troubleshooting = [
  [
    'The panel does not appear',
    'Confirm that TokGrid is enabled, open a supported tiktok.com page, and refresh. The panel is designed for public pages, not private or logged-in-only content.',
  ],
  [
    'No videos are listed',
    'Scroll to load cards, or use auto-load on a supported list page. A login wall, rate limit, or a page with no rendered cards can leave the list empty.',
  ],
  [
    'A download fails',
    'Media URLs can expire, or the video may not expose a playable source. Refresh the page and try again. In a batch, failed items are listed separately and do not stop the rest of the queue.',
  ],
  [
    'Subtitles are missing',
    'Not every video has subtitle tracks. TokGrid can save original and translated tracks when the page exposes them, including a backup source, but it cannot create subtitles that do not exist.',
  ],
  [
    'Batch download is unavailable',
    'Batch download is a Pro feature and requires Chrome 111 or newer. The browser will ask you to choose a destination folder before the queue starts.',
  ],
  [
    'Pro status is not active',
    'Open the subscription flow from Settings, complete checkout, and return to the extension. Use the restore or refresh control if the status does not update.',
  ],
];
---

<BaseLayout title={title} description={description} canonicalPath="/support/" jsonLd={jsonLd}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Support', href: '/support/' },
        ]}
      />
      <div class="mt-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          Support
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Support & FAQ
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Installation, supported pages, Pro activation, and what to check when something
          is not working. TokGrid is intentionally scoped to public pages.
        </p>
        <div class="mt-7">
          <InstallButton campaign="support" label="Open the Chrome Web Store" />
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-12 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div class="min-w-0">
      <section>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Install and open the panel</h2>
        <ol class="mt-5 space-y-4">
          {[
            ['Install from the Chrome Web Store', 'Open the TokGrid listing and add the extension to Chrome. Pin it if you want quick access.'],
            ['Open a supported public page', 'Sign out of private content and open a public TikTok page from the supported list.'],
            ['Find the panel', 'The TokGrid panel appears on the page. If it is collapsed, use the button in the lower-right corner to reopen it.'],
            ['Review the sample', 'Use the Data, Stats, and Products tabs. Settings contains overlay, naming, export, storage, and privacy controls.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Supported public pages</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          TokGrid is built for pages you can open without logging in. Supported page types:
        </p>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {supportedPages.map((page) => (
            <li class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
              <Icon name="check" class="h-4 w-4 shrink-0 text-brand-600" />
              {page}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs leading-5 text-slate-500">
          The extension does not bypass login, CAPTCHA, or rate limits. A supported page can
          still contain content that is not exposed in the available page data.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Troubleshooting</h2>
        <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full border-collapse text-left text-sm">
            <caption class="sr-only">Common TokGrid problems and checks</caption>
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="px-3 py-3 sm:px-5 sm:py-3.5 font-bold text-slate-900">Symptom</th>
                <th scope="col" class="px-3 py-3 sm:px-5 sm:py-3.5 font-bold text-slate-900">What to check</th>
              </tr>
            </thead>
            <tbody>
              {troubleshooting.map(([symptom, check]) => (
                <tr class="border-t border-slate-100 align-top">
                  <th scope="row" class="px-3 py-3 sm:px-5 sm:py-3.5 font-semibold text-slate-800">{symptom}</th>
                  <td class="px-3 py-3 sm:px-5 sm:py-3.5 text-slate-600">{check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Pro and content rights</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="text-sm font-bold text-slate-950">Pro activation</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Pro covers batch downloads, selected-video CSV/JSON export, and product data
              export. Open the subscription flow from Settings for the current plan details.
              TokGrid does not handle card details; the checkout is external.
            </p>
          </div>
          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <h3 class="text-sm font-bold text-slate-950">Only download what you have rights to use</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">
              Follow applicable law, TikTok’s terms, and the content owner’s permissions.
              TokGrid does not grant permission and does not bypass access controls or DRM.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">FAQ</h2>
        <div class="mt-5">
          <FAQ items={SUPPORT_FAQS} />
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Contact</h2>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <div class="flex gap-3">
            <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />
            <div>
              <p class="text-sm font-bold text-slate-950">Email support</p>
              <p class="mt-1.5 text-sm leading-6 text-slate-600">
                Write to{' '}
                <a
                  href={`mailto:${SITE.supportEmail}`}
                  class="font-semibold text-brand-700 hover:underline"
                >
                  {SITE.supportEmail}
                </a>
                {' '}for support or privacy questions. Do not send page data, account
                credentials, or subscription tokens in a support request.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <aside class="space-y-5">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-bold text-slate-950">Quick links</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/features/video-analytics/" class="text-slate-600 hover:text-brand-700">Video analytics</a></li>
          <li><a href="/features/product-research/" class="text-slate-600 hover:text-brand-700">Product research</a></li>
          <li><a href="/features/bulk-download/" class="text-slate-600 hover:text-brand-700">Video & subtitle downloads</a></li>
          <li><a href="/features/data-export/" class="text-slate-600 hover:text-brand-700">Data export</a></li>
          <li><a href="/guides/" class="text-slate-600 hover:text-brand-700">Guides</a></li>
          <li><a href="/privacy/" class="text-slate-600 hover:text-brand-700">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-sm font-bold text-slate-950">Version</h2>
        <p class="mt-2 text-sm text-slate-600">Current build: {SITE.version}</p>
        <a href="/changelog/" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800">
          View changelog <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </aside>
  </div>

  <CTA
    campaign="support-final"
    title="Still stuck? Start with a supported public page."
    description="Most panel issues are page-scope issues: a private page, an unrendered list, or a page that has not finished loading."
    secondaryHref="/guides/"
    secondaryLabel="Read the guides"
  />
</BaseLayout>
