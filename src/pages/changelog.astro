---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../data/site';

const title = 'Changelog — TokGrid';
const description =
  'The current TokGrid public build, version 0.1.2: page overlay, video analytics, product research, downloads, Pro batch workflows, and data export.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Changelog', href: '/changelog/' },
  ]),
];

const groups = [
  {
    title: 'Page overlay and data list',
    items: [
      'Overlay badges for views, engagement rate, and commerce/ad status, with optional likes.',
      'Hover details for likes, comments, shares, saves, published time, duration, author followers, page median views, and text language.',
      'Data list with covers, duration badges, metrics, card/list preview, filtering, sorting, and pagination.',
      'Quick filters for high engagement, last 7 days, and commerce-first.',
    ],
  },
  {
    title: 'Analytics',
    items: [
      'Sample overview with medians and valid coverage.',
      'Top 10 rankings by views, likes, saves, or engagement rate.',
      'Views-by-engagement scatter with linear and log scale options.',
      'Publishing frequency, duration distribution, and engagement composition.',
      'One-click copy for the content and publishing metrics.',
    ],
  },
  {
    title: 'Product research',
    items: [
      'Product cards with title, category path, seller ID, SKU count, cover, and identifiers.',
      'Deduplicated Products tab with category distribution at the first, second, or third level.',
      'Product detail gallery and related-video navigation.',
      'Copy product ID, seller ID, SEO link, or all loaded product IDs.',
    ],
  },
  {
    title: 'Downloads',
    items: [
      'Single video download with available quality selection and highest-resolution default.',
      'Single subtitle download in VTT or SRT, including original and translated tracks when available.',
      'Backup subtitle source fallback when the primary URL fails.',
      'Pro batch downloads with a three-way queue, streaming writes, progress, failure reporting, cancellation, and optional original-language SRT.',
    ],
  },
  {
    title: 'Data export',
    items: [
      'Pro CSV and JSON export for selected videos.',
      'Configurable export fields across basic, engagement, author, content, product, and flag groups.',
      'Pro CSV and JSON export for loaded product data.',
      'Selection shared with the batch download workflow.',
    ],
  },
  {
    title: 'Interface and privacy',
    items: [
      'Settings for overlay fields, download naming, export fields, storage usage, and data clearing.',
      'In-memory network activity log for requests the extension initiates.',
      '30 interface languages, following the browser UI language.',
      'Local page processing, with no analytics or telemetry in the extension.',
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/changelog/" jsonLd={jsonLd}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Changelog', href: '/changelog/' },
        ]}
      />
      <div class="mt-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          Changelog
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Changelog
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          What is in the current public build. This page records capabilities, not a
          version-by-version diff, and it will be updated as new releases ship.
        </p>
      </div>
    </div>
  </section>

  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <aside>
        <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
            Current build
          </p>
          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
            v{SITE.version}
          </p>
          <p class="mt-1 text-sm text-slate-500">November 2026</p>
          <p class="mt-4 text-xs leading-5 text-slate-500">
            Earlier release notes were not published. This entry describes the current
            public build rather than claiming a complete version history.
          </p>
        </div>
      </aside>

      <div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-emerald-700">
              Current
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-slate-950">
              Version {SITE.version}
            </h2>
            <span class="text-sm text-slate-500">November 2026</span>
          </div>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
            The current build includes the local-first page overlay, data list, sample
            analytics, product research, single downloads, and the Pro batch/export
            workflows. Feature availability still depends on what a public page exposes.
          </p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {groups.map((group) => (
              <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <h3 class="text-sm font-bold uppercase tracking-[0.1em] text-brand-700">
                  {group.title}
                </h3>
                <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                  {group.items.map((item) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-brand-600" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-slate-700">
            <div class="flex gap-3">
              <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" />
              <div>
                <p class="font-semibold text-slate-900">Not in this build</p>
                <p class="mt-1">
                  Cross-page deduplicated merge, seven-day local snapshots, seller
                  distribution, creator ratings, automated outreach, deep cross-creator
                  comparison, and historical trend charts are not available. They should
                  not be treated as current features.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CTA
    campaign="changelog-final"
    title="Install the current build."
    description="Core features are free. Pro adds batch downloads and CSV/JSON export for selected videos and product data."
    secondaryHref="/features/"
    secondaryLabel="Explore the features"
  />
</BaseLayout>
