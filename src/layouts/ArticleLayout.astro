---
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, guidePath, type Guide } from '../lib/content';
import { articleSchema, breadcrumbSchema } from '../lib/schema';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: Guide;
  headings: Heading[];
  related: Guide[];
  prev: Guide | null;
  next: Guide | null;
}

const { entry, headings, related, prev, next } = Astro.props;
const path = guidePath(entry);
const published = entry.data.pubDate.toISOString();
const modified = (entry.data.updatedDate ?? entry.data.pubDate).toISOString();
const title = `${entry.data.title} — TokGrid`;

const jsonLd = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.description,
    path,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.updatedDate,
    category: entry.data.category,
  }),
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/guides/' },
    { name: entry.data.title, href: path },
  ]),
];

const featureHref = entry.data.featureHref;
const featureLabel = entry.data.featureLabel ?? 'Explore the related feature';
---

<BaseLayout
  title={title}
  description={entry.data.description}
  type="article"
  canonicalPath={path}
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={jsonLd}
>
  <div class="container-page pt-10 pb-16 sm:pt-12 sm:pb-20">
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Guides', href: '/guides/' },
        { name: entry.data.title, href: path },
      ]}
    />

    <article class="mt-8">
      <header class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <span
            class="rounded-full bg-brand-50 px-2.5 py-1 font-bold uppercase tracking-[0.08em] text-brand-700"
          >
            {entry.data.category}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="calendar" class="h-3.5 w-3.5" />
            {formatDate(entry.data.pubDate)}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" class="h-3.5 w-3.5" />
            {entry.data.readingTime} min read
          </span>
        </div>

        <h1
          class="mt-5 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl"
        >
          {entry.data.title}
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          {entry.data.description}
        </p>
      </header>

      {
        entry.data.takeaways.length > 0 && (
          <aside class="mt-8 max-w-3xl rounded-2xl border border-brand-200 bg-brand-50/70 p-6">
            <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-brand-800">
              Key takeaways
            </h2>
            <ul class="mt-3 space-y-2 text-sm leading-6 text-brand-950">
              {entry.data.takeaways.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <details class="mt-8 max-w-3xl rounded-xl border border-slate-200 bg-white p-4 lg:hidden">
        <summary class="cursor-pointer text-sm font-semibold text-slate-900">
          On this page
        </summary>
        <div class="mt-4">
          <TableOfContents headings={headings} />
        </div>
      </details>

      <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="min-w-0">
          <div class="prose max-w-3xl">
            <slot />
          </div>

          {
            featureHref && (
              <a
                href={featureHref}
                class="mt-10 flex max-w-3xl flex-col gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-6 transition-colors hover:border-brand-300 hover:bg-brand-50/50"
              >
                <span class="text-xs font-bold uppercase tracking-[0.12em] text-brand-700">
                  Related TokGrid feature
                </span>
                <span class="text-lg font-bold text-slate-950">{featureLabel}</span>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700">
                  Learn how it works
                  <Icon name="arrow" class="h-4 w-4" />
                </span>
              </a>
            )
          }

          <div class="mt-10 max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-600">
            <p class="font-semibold text-slate-900">A note on scope</p>
            <p class="mt-2">
              This guide describes TokGrid’s behavior on public TikTok pages. Page data is
              processed locally; the extension does not promise complete account histories,
              platform-wide statistics, sales figures, or access to non-public content.
            </p>
          </div>
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="mt-16 border-t border-slate-200 pt-10">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">
                Keep reading
              </p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
                Related guides
              </h2>
            </div>
            <a
              href="/guides/"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
            >
              All guides
              <Icon name="arrow" class="h-4 w-4" />
            </a>
          </div>
          <div class="mt-6 grid gap-5 md:grid-cols-3">
            {related.map((guide) => <ArticleCard entry={guide} />)}
          </div>
        </section>
      )
    }

    <nav
      class="mt-12 flex flex-col justify-between gap-3 border-t border-slate-200 pt-6 sm:flex-row"
      aria-label="Article pagination"
    >
      {
        prev ? (
          <a href={guidePath(prev)} class="group max-w-sm">
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
              Previous
            </span>
            <span class="mt-1 block text-sm font-semibold text-slate-900 group-hover:text-brand-700">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={guidePath(next)} class="group max-w-sm text-left sm:text-right">
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
              Next
            </span>
            <span class="mt-1 block text-sm font-semibold text-slate-900 group-hover:text-brand-700">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>

  <CTA
    campaign={`guide-${entry.id}`}
    title="Put this guide into practice on a page you already have open."
    description="Install TokGrid, open a supported public TikTok page, and review the sample in your browser. Core features are free; Pro adds batch workflows."
    secondaryHref="/guides/"
    secondaryLabel="Browse more guides"
  />
</BaseLayout>
